IOT_IDS_DATABASE_URL=sqlite:///./iot_ids.db
# Required by docker-compose.yml. Generate a long URL-safe value; do not commit it.
IOT_IDS_POSTGRES_PASSWORD=
IOT_IDS_MODEL_DIR=../models/production
IOT_IDS_DATASET_PATH=../data/raw/RT_IOT2022.csv
IOT_IDS_SCHEMA_PATH=../data/schema/rt_iot2022_v1.json
IOT_IDS_ALLOW_FALLBACK=false
IOT_IDS_CORS_ORIGINS=http://localhost:5173
# Hostnames only; add the deployment hostname explicitly (no URL scheme or port).
IOT_IDS_ALLOWED_HOSTS=localhost,127.0.0.1
IOT_IDS_INGESTION_QUEUE_LIMIT=10000
IOT_IDS_WORKER_POLL_SECONDS=0.5
IOT_IDS_WORKER_LEASE_SECONDS=60
IOT_IDS_OUTBOX_POLL_SECONDS=0.5
IOT_IDS_OUTBOX_LEASE_SECONDS=30
# API availability guards. The body limit applies even without Content-Length.
IOT_IDS_MAX_REQUEST_BODY_BYTES=52428800
IOT_IDS_MAX_LIVE_CONNECTIONS=250
IOT_IDS_LIVE_SEND_TIMEOUT_SECONDS=2
# Business data and live telemetry require these credentials; probes/auth bootstrap stay public.
IOT_IDS_AUTH_ENABLED=true
IOT_IDS_ADMIN_USERNAME=admin
# Keep Argon2 hashes single-quoted so Compose treats their $ characters literally.
IOT_IDS_ADMIN_PASSWORD_HASH=''
IOT_IDS_SECRET_KEY=
IOT_IDS_ACCESS_TOKEN_MINUTES=30
IOT_IDS_LOG_LEVEL=INFO
IOT_IDS_LOG_FORMAT=json
# Leave these unset for the recommended same-origin Nginx/Vite proxy.
VITE_API_URL=
VITE_WS_URL=
