IOT_IDS_DATABASE_URL=sqlite:///./iot_ids.db
IOT_IDS_MODEL_DIR=../models/production
IOT_IDS_DATASET_PATH=../data/raw/RT_IOT2022.csv
IOT_IDS_SCHEMA_PATH=../data/schema/rt_iot2022_v1.json
IOT_IDS_ALLOW_FALLBACK=false
IOT_IDS_CORS_ORIGINS=http://localhost:5173
IOT_IDS_INGESTION_QUEUE_LIMIT=10000
IOT_IDS_WORKER_POLL_SECONDS=0.5
IOT_IDS_WORKER_LEASE_SECONDS=60
IOT_IDS_OUTBOX_POLL_SECONDS=0.5
# Read APIs remain public. Enable auth only after setting the hash and secret.
IOT_IDS_AUTH_ENABLED=false
IOT_IDS_ADMIN_USERNAME=admin
IOT_IDS_ADMIN_PASSWORD_HASH=
IOT_IDS_SECRET_KEY=
IOT_IDS_ACCESS_TOKEN_MINUTES=30
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/live
